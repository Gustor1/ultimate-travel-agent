{
  "$defs": {
    "Accommodation": {
      "description": "Accommodation recommendation or reservation details.",
      "properties": {
        "id": {
          "description": "Unique accommodation identifier",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "description": "Name of the hotel, apartment, or lodging",
          "title": "Name",
          "type": "string"
        },
        "destination_id": {
          "description": "Referenced destination identifier",
          "title": "Destination Id",
          "type": "string"
        },
        "neighborhood": {
          "description": "Strategic neighborhood or district name",
          "title": "Neighborhood",
          "type": "string"
        },
        "accommodation_type": {
          "$ref": "#/$defs/AccommodationType",
          "default": "hotel",
          "description": "Type of accommodation"
        },
        "cost_per_night": {
          "description": "Estimated cost per night",
          "title": "Cost Per Night",
          "type": "number"
        },
        "total_nights": {
          "default": 1,
          "description": "Number of nights booked or planned",
          "title": "Total Nights",
          "type": "integer"
        },
        "currency": {
          "default": "EUR",
          "description": "Currency code for cost",
          "title": "Currency",
          "type": "string"
        },
        "quietness_rating": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Quietness assessment: high, medium, noisy",
          "title": "Quietness Rating"
        },
        "criteria_matched": {
          "description": "List of traveler criteria satisfied (e.g. ['metro proximity', 'quiet street', 'kitchen'])",
          "items": {
            "type": "string"
          },
          "title": "Criteria Matched",
          "type": "array"
        },
        "official_booking_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Direct URL to hotel or official lodging site (never automated booking)",
          "title": "Official Booking Url"
        },
        "verification_level": {
          "$ref": "#/$defs/VerificationLevel",
          "default": "unverified",
          "description": "Level of verification of this listing"
        },
        "sources": {
          "description": "Sources confirming price or reputation",
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "destination_id",
        "neighborhood",
        "cost_per_night"
      ],
      "title": "Accommodation",
      "type": "object"
    },
    "AccommodationType": {
      "description": "Types of accommodations.",
      "enum": [
        "hotel",
        "apartment",
        "hostel",
        "guesthouse",
        "resort",
        "campsite"
      ],
      "title": "AccommodationType",
      "type": "string"
    },
    "Activity": {
      "description": "Activity, museum, landmark, or dining experience with rich context.",
      "properties": {
        "id": {
          "description": "Unique activity identifier",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "description": "Name of the activity or venue",
          "title": "Title",
          "type": "string"
        },
        "destination_id": {
          "description": "Destination identifier where activity is located",
          "title": "Destination Id",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/ActivityCategory",
          "default": "culture",
          "description": "Category of activity"
        },
        "description": {
          "description": "Description of the visit or experience",
          "title": "Description",
          "type": "string"
        },
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Country where the activity is located",
          "title": "Country"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Region or province",
          "title": "Region"
        },
        "city": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "City name",
          "title": "City"
        },
        "neighborhood": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Neighborhood or district",
          "title": "Neighborhood"
        },
        "anecdote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Anecdote, local story, or cultural context about the venue",
          "title": "Anecdote"
        },
        "environment": {
          "$ref": "#/$defs/EnvironmentType",
          "default": "indoor",
          "description": "Indoor, outdoor, or hybrid environment"
        },
        "difficulty_level": {
          "$ref": "#/$defs/DifficultyLevel",
          "default": "easy",
          "description": "Physical difficulty: easy, moderate, demanding"
        },
        "accessibility": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Accessibility features (wheelchair, reduced mobility, stroller, sensory)",
          "title": "Accessibility"
        },
        "duration_minutes": {
          "default": 90,
          "description": "Recommended visit duration in minutes",
          "title": "Duration Minutes",
          "type": "integer"
        },
        "best_time_slot": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Best time of day or slot to visit (e.g. '08:30 - 10:00' or 'sunset')",
          "title": "Best Time Slot"
        },
        "opening_hours": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Standard operating hours and opening days",
          "title": "Opening Hours"
        },
        "estimated_cost": {
          "default": 0.0,
          "description": "Cost per person in currency",
          "title": "Estimated Cost",
          "type": "number"
        },
        "currency": {
          "default": "EUR",
          "description": "Currency ISO code",
          "title": "Currency",
          "type": "string"
        },
        "access_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How to reach the venue (e.g. 'Metro L3 to Fontana, then 7 min walk')",
          "title": "Access Method"
        },
        "transit_duration_minutes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Estimated transit time from lodging/hub in minutes",
          "title": "Transit Duration Minutes"
        },
        "transit_cost": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Estimated transit fare per person",
          "title": "Transit Cost"
        },
        "advance_booking_required": {
          "default": false,
          "description": "Whether advance timed tickets are strictly mandatory",
          "title": "Advance Booking Required",
          "type": "boolean"
        },
        "official_booking_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Direct link to official ticketing box office",
          "title": "Official Booking Url"
        },
        "crowd_level": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "medium",
          "description": "Observed crowd density: low, medium, high, extreme",
          "title": "Crowd Level"
        },
        "quiet_slot_advice": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Advice on optimal slot to avoid peak crowds (e.g. 'Enter at 08:30 or after 17:00')",
          "title": "Quiet Slot Advice"
        },
        "crowd_avoidance_strategy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Specific strategy to bypass peak crowds or queues",
          "title": "Crowd Avoidance Strategy"
        },
        "indoor_contingency": {
          "default": false,
          "description": "Whether this activity itself serves as a rainy-day indoor backup",
          "title": "Indoor Contingency",
          "type": "boolean"
        },
        "weather_alternative": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Recommended indoor alternative activity if weather is poor",
          "title": "Weather Alternative"
        },
        "closure_alternative": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Recommended alternative activity in case of unexpected closure or strike",
          "title": "Closure Alternative"
        },
        "verification_level": {
          "$ref": "#/$defs/VerificationLevel",
          "default": "unverified",
          "description": "Verification level of activity information"
        },
        "sources": {
          "description": "Sources used to verify hours, ticketing, and crowding",
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "destination_id",
        "description"
      ],
      "title": "Activity",
      "type": "object"
    },
    "ActivityCategory": {
      "description": "Categories of activities and attractions.",
      "enum": [
        "nature",
        "landscape",
        "culture",
        "history",
        "gastronomy",
        "adventure",
        "relaxation",
        "city_sightseeing",
        "family",
        "photography",
        "shopping",
        "nightlife"
      ],
      "title": "ActivityCategory",
      "type": "string"
    },
    "BookingRequirement": {
      "description": "Booking requirement or confirmed reservation (r\u00e9servation).\n\nStrict policy: Never triggers automated payment or purchase.\nAll actions must be executed manually by the traveler on official portals.",
      "properties": {
        "id": {
          "description": "Unique booking requirement identifier",
          "title": "Id",
          "type": "string"
        },
        "category": {
          "description": "Booking category: transport, accommodation, activity, permit, visa, other",
          "title": "Category",
          "type": "string"
        },
        "title": {
          "description": "Title of the booking requirement",
          "title": "Title",
          "type": "string"
        },
        "status": {
          "default": "needed",
          "description": "Booking status: needed, booked, not_needed, optional",
          "title": "Status",
          "type": "string"
        },
        "mandatory": {
          "default": true,
          "description": "Whether this reservation is mandatory",
          "title": "Mandatory",
          "type": "boolean"
        },
        "reference_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Linked entity ID (e.g. transport_id, accommodation_id, activity_id)",
          "title": "Reference Id"
        },
        "deadline_days_before": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Recommended advance booking deadline in days before departure",
          "title": "Deadline Days Before"
        },
        "confirmation_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Official reservation reference or PNR (if already booked)",
          "title": "Confirmation Code"
        },
        "estimated_cost": {
          "default": 0.0,
          "description": "Estimated total cost",
          "title": "Estimated Cost",
          "type": "number"
        },
        "currency": {
          "default": "EUR",
          "description": "Currency ISO code",
          "title": "Currency",
          "type": "string"
        },
        "official_booking_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Direct link to official ticketing or lodging reservation portal",
          "title": "Official Booking Url"
        },
        "action_required": {
          "default": "",
          "description": "Human instructions for completing the reservation",
          "title": "Action Required",
          "type": "string"
        },
        "verification_level": {
          "$ref": "#/$defs/VerificationLevel",
          "default": "official_verified",
          "description": "Confidence level of booking requirement and link"
        },
        "sources": {
          "description": "Authoritative sources for ticketing and terms",
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "id",
        "category",
        "title"
      ],
      "title": "BookingRequirement",
      "type": "object"
    },
    "Budget": {
      "description": "Overall consolidated budget for the trip.",
      "properties": {
        "currency": {
          "default": "EUR",
          "description": "Primary currency",
          "title": "Currency",
          "type": "string"
        },
        "total_estimated_cost": {
          "default": 0.0,
          "description": "Sum of estimated itemized expenses",
          "title": "Total Estimated Cost",
          "type": "number"
        },
        "safety_buffer_percentage": {
          "default": 12.0,
          "description": "Recommended buffer percentage (10-15%)",
          "title": "Safety Buffer Percentage",
          "type": "number"
        },
        "safety_buffer_amount": {
          "default": 0.0,
          "description": "Calculated contingency reserve amount",
          "title": "Safety Buffer Amount",
          "type": "number"
        },
        "grand_total": {
          "default": 0.0,
          "description": "Total including contingency buffer",
          "title": "Grand Total",
          "type": "number"
        },
        "categories": {
          "additionalProperties": {
            "$ref": "#/$defs/BudgetCategoryBreakdown"
          },
          "description": "Breakdown mapped by category name",
          "title": "Categories",
          "type": "object"
        },
        "warnings": {
          "description": "Budget warnings (e.g. over budget cap, unverified estimates)",
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "BudgetCategoryBreakdown": {
      "description": "Breakdown of expenses for a specific category.",
      "properties": {
        "category": {
          "description": "Category: transport, accommodation, activities, meals, miscellaneous",
          "title": "Category",
          "type": "string"
        },
        "amount": {
          "description": "Estimated cost amount",
          "title": "Amount",
          "type": "number"
        },
        "currency": {
          "default": "EUR",
          "description": "Currency code",
          "title": "Currency",
          "type": "string"
        },
        "verification_level": {
          "$ref": "#/$defs/VerificationLevel",
          "default": "unverified",
          "description": "Overall verification status of prices in this category"
        },
        "notes": {
          "description": "Explanatory notes or cost ranges",
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "category",
        "amount"
      ],
      "title": "BudgetCategoryBreakdown",
      "type": "object"
    },
    "ChecklistCategory": {
      "description": "Categories for pre-travel and preparation tasks.",
      "enum": [
        "documents_visa",
        "health_vaccines",
        "finance_currency",
        "connectivity_sim",
        "luggage_gear",
        "safety_emergency"
      ],
      "title": "ChecklistCategory",
      "type": "string"
    },
    "ChecklistItem": {
      "description": "Preparation task or regulatory requirement.",
      "properties": {
        "id": {
          "description": "Unique task identifier",
          "title": "Id",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/ChecklistCategory",
          "default": "documents_visa",
          "description": "Category of preparation task"
        },
        "title": {
          "description": "Title of the task",
          "title": "Title",
          "type": "string"
        },
        "description": {
          "description": "Details and actionable instructions",
          "title": "Description",
          "type": "string"
        },
        "is_mandatory": {
          "default": true,
          "description": "Whether completion is legally or logistically mandatory",
          "title": "Is Mandatory",
          "type": "boolean"
        },
        "due_before_departure_days": {
          "default": 7,
          "description": "Recommended deadline in days prior to departure date",
          "title": "Due Before Departure Days",
          "type": "integer"
        },
        "verification_level": {
          "$ref": "#/$defs/VerificationLevel",
          "default": "official_verified",
          "description": "Confidence level of the requirement"
        },
        "official_reference_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Official embassy, consulate, or government advisory URL",
          "title": "Official Reference Url"
        },
        "completed": {
          "default": false,
          "description": "User completion checkmark",
          "title": "Completed",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "title",
        "description"
      ],
      "title": "ChecklistItem",
      "type": "object"
    },
    "CrowdSensitivity": {
      "description": "Sensitivity to crowds and overtourism.",
      "enum": [
        "standard",
        "avoid_crowds",
        "extreme_quiet"
      ],
      "title": "CrowdSensitivity",
      "type": "string"
    },
    "DaySchedule": {
      "description": "Chronological plan for a single day of travel.",
      "properties": {
        "day_number": {
          "description": "1-indexed day sequence number",
          "title": "Day Number",
          "type": "integer"
        },
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO date YYYY-MM-DD",
          "title": "Date"
        },
        "destination_id": {
          "description": "Active destination identifier",
          "title": "Destination Id",
          "type": "string"
        },
        "theme": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Day theme (e.g. 'Gaud\u00ed Architecture & Gothic Quarter')",
          "title": "Theme"
        },
        "items": {
          "description": "Ordered schedule events",
          "items": {
            "$ref": "#/$defs/ItineraryItem"
          },
          "title": "Items",
          "type": "array"
        },
        "daily_cost_estimate": {
          "default": 0.0,
          "description": "Estimated total cost for the day",
          "title": "Daily Cost Estimate",
          "type": "number"
        },
        "currency": {
          "default": "EUR",
          "description": "Currency code",
          "title": "Currency",
          "type": "string"
        },
        "weather_contingency_notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Contingency advice in case of rain or storms",
          "title": "Weather Contingency Notes"
        }
      },
      "required": [
        "day_number",
        "destination_id"
      ],
      "title": "DaySchedule",
      "type": "object"
    },
    "Destination": {
      "description": "Geographic destination for a trip or trip leg.",
      "properties": {
        "id": {
          "description": "Unique destination identifier (e.g. bcn, tyo)",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "description": "City or area name (e.g. Barcelona)",
          "title": "Name",
          "type": "string"
        },
        "country": {
          "description": "Country name (e.g. Spain)",
          "title": "Country",
          "type": "string"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Region or province (e.g. Catalonia)",
          "title": "Region"
        },
        "currency": {
          "default": "EUR",
          "description": "Local currency ISO code (e.g. EUR, JPY)",
          "title": "Currency",
          "type": "string"
        },
        "timezone": {
          "default": "UTC",
          "description": "Timezone name (e.g. Europe/Madrid)",
          "title": "Timezone",
          "type": "string"
        },
        "ideal_seasons": {
          "description": "Best months or seasons to visit (e.g. ['April-May', 'September-October'])",
          "items": {
            "type": "string"
          },
          "title": "Ideal Seasons",
          "type": "array"
        },
        "quiet_periods": {
          "description": "Low season / quiet periods to avoid peak crowds",
          "items": {
            "type": "string"
          },
          "title": "Quiet Periods",
          "type": "array"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Overview of the destination",
          "title": "Description"
        },
        "anecdote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Interesting local fact or historical anecdote",
          "title": "Anecdote"
        }
      },
      "required": [
        "id",
        "name",
        "country"
      ],
      "title": "Destination",
      "type": "object"
    },
    "DifficultyLevel": {
      "description": "Physical difficulty of an activity or trail.",
      "enum": [
        "easy",
        "moderate",
        "demanding"
      ],
      "title": "DifficultyLevel",
      "type": "string"
    },
    "EnvironmentType": {
      "description": "Physical environment type for an activity or POI.",
      "enum": [
        "indoor",
        "outdoor",
        "hybrid"
      ],
      "title": "EnvironmentType",
      "type": "string"
    },
    "InterCityRoute": {
      "description": "Collection of competing route options between two key journey points.",
      "properties": {
        "id": {
          "description": "Unique inter-city route identifier",
          "title": "Id",
          "type": "string"
        },
        "origin": {
          "description": "Departure city or stage",
          "title": "Origin",
          "type": "string"
        },
        "destination": {
          "description": "Destination city or stage",
          "title": "Destination",
          "type": "string"
        },
        "options": {
          "description": "Available transit options",
