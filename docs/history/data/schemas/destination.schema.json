{
  "description": "Geographic destination for a trip or trip leg.",
  "properties": {
    "id": {
      "description": "Unique destination identifier (e.g. bcn, tyo)",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "description": "City or area name (e.g. Barcelona)",
      "title": "Name",
      "type": "string"
    },
    "country": {
      "description": "Country name (e.g. Spain)",
      "title": "Country",
      "type": "string"
    },
    "region": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Region or province (e.g. Catalonia)",
      "title": "Region"
    },
    "currency": {
      "default": "EUR",
      "description": "Local currency ISO code (e.g. EUR, JPY)",
      "title": "Currency",
      "type": "string"
    },
    "timezone": {
      "default": "UTC",
      "description": "Timezone name (e.g. Europe/Madrid)",
      "title": "Timezone",
      "type": "string"
    },
    "ideal_seasons": {
      "description": "Best months or seasons to visit (e.g. ['April-May', 'September-October'])",
      "items": {
        "type": "string"
      },
      "title": "Ideal Seasons",
      "type": "array"
    },
    "quiet_periods": {
      "description": "Low season / quiet periods to avoid peak crowds",
      "items": {
        "type": "string"
      },
      "title": "Quiet Periods",
      "type": "array"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Overview of the destination",
      "title": "Description"
    },
    "anecdote": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Interesting local fact or historical anecdote",
      "title": "Anecdote"
    }
  },
  "required": [
    "id",
    "name",
    "country"
  ],
  "title": "Destination",
  "type": "object"
}