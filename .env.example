# Travel Agent Execution Mode (offline | mock | live)
TRAVEL_AGENT_MODE=offline
LOG_LEVEL=INFO

# Flight Providers
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AVIATION_EDGE_API_KEY=

# Rail & Transit Providers
NAVITIA_API_KEY=
SNCF_API_KEY=

# Accommodation & Review Providers
STAYAPI_API_KEY=
TRIPADVISOR_API_KEY=
BOOKING_API_KEY=

# Activity Providers
GETYOURGUIDE_API_KEY=
VIATOR_API_KEY=
OPENTRIPMAP_API_KEY=

# Maps & Routing Providers
GOOGLE_MAPS_API_KEY=
ORS_API_KEY=
OSRM_BACKEND_URL=

# Weather Providers
OPENWEATHER_API_KEY=
OPEN_METEO_URL=

# MCP Server
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8765

# Phase 10: Keyless Public Data Providers (Zero API keys, zero accounts required)
TRAVEL_MCP_ENABLE_KEYLESS_LIVE_PROVIDERS=false
TRAVEL_MCP_ENABLE_OPEN_METEO=true
TRAVEL_MCP_ENABLE_ECB=true
TRAVEL_MCP_ENABLE_WIKIVOYAGE=true
TRAVEL_MCP_ENABLE_NOMINATIM=false
TRAVEL_MCP_ENABLE_OSRM=false
TRAVEL_MCP_HTTP_USER_AGENT=UltimateTravelAgent/1.0 (https://github.com/Gustor1/ultimate-travel-agent)
TRAVEL_HTTP_TIMEOUT=5.0
