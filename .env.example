# ==============================================================================
# Ultimate Travel Agent — Configuration des variables d'environnement
# ==============================================================================
# RAPPEL DE SÉCURITÉ :
# Ne commitez JAMAIS votre fichier .env réel.
# Aucune clé n'est requise pour le fonctionnement local standard (mode mock/hors-ligne).
# ==============================================================================

# Mode d'exécution général
# Options : offline (défaut, 100% déterministe/local), hybrid, online
TRAVEL_AGENT_MODE=offline

# Journalisation (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Intégrations optionnelles (Phase 4 / Phase 5) - Laisser vide en mode local
# OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
# OSRM_BACKEND_URL=http://localhost:5000
# AMADEUS_CLIENT_ID=your_sandbox_client_id_here
# AMADEUS_CLIENT_SECRET=your_sandbox_client_secret_here
# COMPOSIO_API_KEY=your_composio_api_key_here

# MCP Server Configuration
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8765
