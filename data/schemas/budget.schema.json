{
  "$defs": {
    "BudgetCategoryBreakdown": {
      "description": "Breakdown of expenses for a specific category.",
      "properties": {
        "category": {
          "description": "Category: transport, accommodation, activities, meals, miscellaneous",
          "title": "Category",
          "type": "string"
        },
        "amount": {
          "description": "Estimated cost amount",
          "title": "Amount",
          "type": "number"
        },
        "currency": {
          "default": "EUR",
          "description": "Currency code",
          "title": "Currency",
          "type": "string"
        },
        "verification_level": {
          "$ref": "#/$defs/VerificationLevel",
          "default": "unverified",
          "description": "Overall verification status of prices in this category"
        },
        "notes": {
          "description": "Explanatory notes or cost ranges",
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "category",
        "amount"
      ],
      "title": "BudgetCategoryBreakdown",
      "type": "object"
    },
    "VerificationLevel": {
      "description": "Trust and verification levels for travel data.",
      "enum": [
        "official_verified",
        "cross_checked",
        "community_recommended",
        "social_discovery_only",
        "unverified",
        "outdated"
      ],
      "title": "VerificationLevel",
      "type": "string"
    }
  },
  "description": "Overall consolidated budget for the trip.",
  "properties": {
    "currency": {
      "default": "EUR",
      "description": "Primary currency",
      "title": "Currency",
      "type": "string"
    },
    "total_estimated_cost": {
      "default": 0.0,
      "description": "Sum of estimated itemized expenses",
      "title": "Total Estimated Cost",
      "type": "number"
    },
    "safety_buffer_percentage": {
      "default": 12.0,
      "description": "Recommended buffer percentage (10-15%)",
      "title": "Safety Buffer Percentage",
      "type": "number"
    },
    "safety_buffer_amount": {
      "default": 0.0,
      "description": "Calculated contingency reserve amount",
      "title": "Safety Buffer Amount",
      "type": "number"
    },
    "grand_total": {
      "default": 0.0,
      "description": "Total including contingency buffer",
      "title": "Grand Total",
      "type": "number"
    },
    "categories": {
      "additionalProperties": {
        "$ref": "#/$defs/BudgetCategoryBreakdown"
      },
      "description": "Breakdown mapped by category name",
      "title": "Categories",
      "type": "object"
    },
    "warnings": {
      "description": "Budget warnings (e.g. over budget cap, unverified estimates)",
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "title": "Budget",
  "type": "object"
}